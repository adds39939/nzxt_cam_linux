+/* Pipe handles are (endpoint | type << 8); see get_pipe() in the Unix library. */
+static HANDLE make_pipe_handle(UCHAR endpoint, USBD_PIPE_TYPE type)
+{
+    return (HANDLE)(ULONG_PTR)(endpoint | (type << 8));
+}
+
+/* Translate a buffered user-mode request into a URB and submit it. The URB is
+ * heap-allocated because the transfer may complete asynchronously; complete_irp()
+ * frees it and reports the transferred length. */
+static NTSTATUS usb_submit_user_urb(struct usb_device *device, IRP *irp)
+{
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    ULONG in_size = stack->Parameters.DeviceIoControl.InputBufferLength;
+    ULONG out_size = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    struct wineusb_urb_request *req = irp->AssociatedIrp.SystemBuffer;
+    void *buffer;
+    NTSTATUS status;
+    URB *urb;
+
+    if (in_size < sizeof(*req) || out_size < sizeof(*req))
+        return STATUS_BUFFER_TOO_SMALL;
+    if (req->transfer_length > max(in_size, out_size) - sizeof(*req))
+        return STATUS_INVALID_PARAMETER;
+
+    if (!(urb = ExAllocatePool(NonPagedPool, sizeof(*urb))))
+        return STATUS_NO_MEMORY;
+    memset(urb, 0, sizeof(*urb));
+    buffer = (char *)req + sizeof(*req);
+
+    switch (req->type)
+    {
+        case WINEUSB_URB_CONTROL:
+        {
+            struct _URB_CONTROL_VENDOR_OR_CLASS_REQUEST *r = &urb->UrbControlVendorClassRequest;
+
+            /* bits 0-4 of bmRequestType select the recipient */
+            switch (req->request_type & 0x1f)
+            {
+                case 1:  urb->UrbHeader.Function = URB_FUNCTION_VENDOR_INTERFACE; break;
+                case 2:  urb->UrbHeader.Function = URB_FUNCTION_VENDOR_ENDPOINT; break;
+                default: urb->UrbHeader.Function = URB_FUNCTION_VENDOR_DEVICE; break;
+            }
+            urb->UrbHeader.Length = sizeof(*r);
+            r->TransferFlags = (req->flags & WINEUSB_TRANSFER_IN) ? USBD_TRANSFER_DIRECTION_IN : 0;
+            r->TransferBufferLength = req->transfer_length;
+            r->TransferBuffer = req->transfer_length ? buffer : NULL;
+            r->RequestTypeReservedBits = req->request_type;
+            r->Request = req->request;
+            r->Value = req->value;
+            r->Index = req->index;
+            break;
+        }
+
+        case WINEUSB_URB_BULK:
+        {
+            struct _URB_BULK_OR_INTERRUPT_TRANSFER *r = &urb->UrbBulkOrInterruptTransfer;
+
+            urb->UrbHeader.Function = URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER;
+            urb->UrbHeader.Length = sizeof(*r);
+            r->PipeHandle = make_pipe_handle(req->endpoint, req->pipe_type);
+            r->TransferFlags = (req->flags & WINEUSB_TRANSFER_IN) ? USBD_TRANSFER_DIRECTION_IN : 0;
+            r->TransferBufferLength = req->transfer_length;
+            r->TransferBuffer = req->transfer_length ? buffer : NULL;
+            break;
+        }
+
+        case WINEUSB_URB_DESCRIPTOR:
+        {
+            struct _URB_CONTROL_DESCRIPTOR_REQUEST *r = &urb->UrbControlDescriptorRequest;
+
+            urb->UrbHeader.Function = URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE;
+            urb->UrbHeader.Length = sizeof(*r);
+            r->TransferBufferLength = req->transfer_length;
+            r->TransferBuffer = req->transfer_length ? buffer : NULL;
+            r->Index = req->descriptor_index;
+            r->DescriptorType = req->descriptor_type;
+            r->LanguageId = req->index;
+            break;
+        }
+
+        case WINEUSB_URB_RESET_PIPE:
+        {
+            struct _URB_PIPE_REQUEST *r = &urb->UrbPipeRequest;
+
+            urb->UrbHeader.Function = URB_FUNCTION_SYNC_RESET_PIPE_AND_CLEAR_STALL;
+            urb->UrbHeader.Length = sizeof(*r);
+            r->PipeHandle = make_pipe_handle(req->endpoint, req->pipe_type);
+            break;
+        }
+
+        case WINEUSB_URB_ABORT_PIPE:
+            urb->UrbHeader.Function = URB_FUNCTION_ABORT_PIPE;
+            urb->UrbHeader.Length = sizeof(urb->UrbPipeRequest);
+            break;
+
+        default:
+            FIXME("Unhandled request type %#lx.\n", req->type);
+            ExFreePool(urb);
+            return STATUS_NOT_IMPLEMENTED;
+    }
+
+    irp->Tail.Overlay.DriverContext[1] = urb;
+    status = usb_submit_urb_urb(device, irp, urb);
+    if (status != STATUS_PENDING)
+    {
+        req->transfer_length = urb_transfer_length(urb);
+        irp->IoStatus.Information = sizeof(*req) + req->transfer_length;
+        ExFreePool(urb);
+        irp->Tail.Overlay.DriverContext[1] = NULL;
+    }
+    return status;
+}
