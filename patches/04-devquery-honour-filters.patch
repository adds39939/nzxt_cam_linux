+static void free_query_filters( DEVPROP_FILTER_EXPRESSION *filters, ULONG len )
+{
+    ULONG i;
+
+    if (!filters) return;
+    for (i = 0; i < len; i++)
+    {
+        free( (void *)filters[i].Property.CompKey.LocaleName );
+        free( filters[i].Property.Buffer );
+    }
+    free( filters );
+}
+
+/* The caller only guarantees the filters for the duration of the call, but the query
+ * is evaluated asynchronously, so take a deep copy. */
+static DEVPROP_FILTER_EXPRESSION *copy_query_filters( const DEVPROP_FILTER_EXPRESSION *filters, ULONG len )
+{
+    DEVPROP_FILTER_EXPRESSION *ret;
+    ULONG i;
+
+    if (!(ret = calloc( len, sizeof( *ret ) ))) return NULL;
+    for (i = 0; i < len; i++)
+    {
+        ret[i] = filters[i];
+        ret[i].Property.Buffer = NULL;
+        ret[i].Property.CompKey.LocaleName = NULL;
+        if (filters[i].Property.Buffer && filters[i].Property.BufferSize)
+        {
+            if (!(ret[i].Property.Buffer = malloc( filters[i].Property.BufferSize ))) goto failed;
+            memcpy( ret[i].Property.Buffer, filters[i].Property.Buffer, filters[i].Property.BufferSize );
+        }
+        if (filters[i].Property.CompKey.LocaleName)
+        {
+            SIZE_T size = (wcslen( filters[i].Property.CompKey.LocaleName ) + 1) * sizeof( WCHAR );
+            WCHAR *name;
+
+            if (!(name = malloc( size ))) goto failed;
+            memcpy( name, filters[i].Property.CompKey.LocaleName, size );
+            ret[i].Property.CompKey.LocaleName = name;
+        }
+    }
+    return ret;
+
+failed:
+    free_query_filters( ret, len );
+    return NULL;
+}
