+/* Build a vector view of the pipes matching direction/type. */
+static HRESULT usb_interface_collect_pipes( struct usb_interface *impl, BOOL want_in, const struct vector_iids *iids,
+                                            void **out )
+{
+    struct usb_device *device = impl_from_IUsbDevice( impl->device );
+    IVector_IInspectable *vector;
+    HRESULT hr;
+    UCHAR i;
+
+    if (FAILED(hr = vector_create( iids, (void **)&vector ))) return hr;
+
+    for (i = 0; i < device->pipe_count; i++)
+    {
+        const WINUSB_PIPE_INFORMATION *pipe = &device->pipes[i];
+        BOOL is_in = !!(pipe->PipeId & 0x80);
+        IInspectable *item;
+
+        if (pipe->PipeType != UsbdPipeTypeBulk || is_in != want_in) continue;
+
+        if (want_in)
+        {
+            struct usb_bulk_in_pipe *in;
+            if (!(in = calloc( 1, sizeof(*in) ))) { hr = E_OUTOFMEMORY; break; }
+            in->IUsbBulkInPipe_iface.lpVtbl = &bulk_in_pipe_vtbl;
+            in->ref = 1;
+            in->pipe_id = pipe->PipeId;
+            in->max_transfer = pipe->MaximumPacketSize;
+            IUsbDevice_AddRef( (in->device = impl->device) );
+            item = (IInspectable *)&in->IUsbBulkInPipe_iface;
+        }
+        else
+        {
+            struct usb_bulk_out_pipe *o;
+            if (!(o = calloc( 1, sizeof(*o) ))) { hr = E_OUTOFMEMORY; break; }
+            o->IUsbBulkOutPipe_iface.lpVtbl = &bulk_out_pipe_vtbl;
+            o->ref = 1;
+            o->pipe_id = pipe->PipeId;
+            IUsbDevice_AddRef( (o->device = impl->device) );
+            item = (IInspectable *)&o->IUsbBulkOutPipe_iface;
+        }
+
+        hr = IVector_IInspectable_Append( vector, item );
+        IInspectable_Release( item );
+        if (FAILED(hr)) break;
+    }
+
+    if (SUCCEEDED(hr)) hr = IVector_IInspectable_GetView( vector, (IVectorView_IInspectable **)out );
+    IVector_IInspectable_Release( vector );
+    return hr;
+}
+
+static HRESULT WINAPI usb_interface_get_BulkInPipes( IUsbInterface *iface, IVectorView_UsbBulkInPipe **value )
+{
+    static const struct vector_iids iids =
+    {
+        .vector = &IID_IVector_IInspectable,
+        .view = &IID_IVectorView_UsbBulkInPipe,
+        .iterable = &IID_IIterable_UsbBulkInPipe,
+        .iterator = &IID_IIterator_UsbBulkInPipe,
