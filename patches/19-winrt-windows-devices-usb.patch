+struct usb_out_stream
+{
+    IOutputStream IOutputStream_iface;
+    LONG ref;
+    IUsbDevice *device;
+    UCHAR pipe_id;
+};
+
+DEFINE_USB_OBJECT_BASE( out_stream, IOutputStream, struct usb_out_stream,
+                        L"Windows.Storage.Streams.IOutputStream" )
+
+static HRESULT out_stream_write( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct usb_out_stream *impl = impl_from_IOutputStream( (IOutputStream *)invoker );
+    struct usb_device *device = impl_from_IUsbDevice( impl->device );
+    IBuffer *buffer = (IBuffer *)param;
+    IBufferByteAccess *access;
+    ULONG written = 0;
+    UINT32 length;
+    BYTE *data;
+
+    IBuffer_get_Length( buffer, &length );
+    if (!length)
+    {
+        result->vt = VT_UI4;
+        result->ulVal = 0;
+        return S_OK;
+    }
+
+    if (FAILED(IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ))) return E_NOINTERFACE;
+    IBufferByteAccess_Buffer( access, &data );
+    IBufferByteAccess_Release( access );
+
+    if (!WinUsb_WritePipe( device->winusb, impl->pipe_id, data, length, &written, NULL ))
+    {
+        WARN( "WinUsb_WritePipe failed on pipe %#x, error %lu.\n", impl->pipe_id, GetLastError() );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+
+    result->vt = VT_UI4;
+    result->ulVal = written;
+    return S_OK;
+}
+
+static HRESULT WINAPI out_stream_WriteAsync( IOutputStream *iface, IBuffer *buffer,
+                                             IAsyncOperationWithProgress_UINT32_UINT32 **operation )
+{
+    TRACE( "iface %p, buffer %p, operation %p.\n", iface, buffer, operation );
+    if (!operation) return E_POINTER;
+    return async_operation_uint32_uint32_create( (IUnknown *)iface, (IUnknown *)buffer, out_stream_write, operation );
+}
+
+static HRESULT WINAPI out_stream_FlushAsync( IOutputStream *iface, IAsyncOperation_boolean **operation )
+{
+    FIXME( "iface %p, operation %p stub!\n", iface, operation );
+    return E_NOTIMPL;
+}
