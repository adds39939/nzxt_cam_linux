+/* Parameter object carrying the device ID into the async worker. */
+struct from_id_params
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    WCHAR *id;
+};
+
+static inline struct from_id_params *impl_from_params_IUnknown( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct from_id_params, IUnknown_iface );
+}
+
+static HRESULT WINAPI params_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        IUnknown_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI params_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &impl_from_params_IUnknown( iface )->ref );
+}
+
+static ULONG WINAPI params_Release( IUnknown *iface )
+{
+    struct from_id_params *impl = impl_from_params_IUnknown( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        free( impl->id );
+        free( impl );
+    }
+    return ref;
+}
+
+static const IUnknownVtbl params_vtbl = { params_QueryInterface, params_AddRef, params_Release };
+
+static HRESULT from_id_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct from_id_params *params = impl_from_params_IUnknown( param );
+    struct usb_device *impl;
+    HANDLE file;
+
+    TRACE( "invoker %p, param %p, result %p, called_async %d\n", invoker, param, result, called_async );
+
+    if (!called_async) return STATUS_PENDING;
+
+    file = CreateFileW( params->id, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                        NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_OVERLAPPED, NULL );
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        WARN( "Failed to open %s, error %lu.\n", debugstr_w( params->id ), GetLastError() );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        CloseHandle( file );
+        return E_OUTOFMEMORY;
+    }
+    impl->IUsbDevice_iface.lpVtbl = &usb_device_vtbl;
+    impl->IClosable_iface.lpVtbl = &closable_vtbl;
+    impl->ref = 1;
+    impl->file = file;
+
+    if (!WinUsb_Initialize( file, &impl->winusb ))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        WARN( "WinUsb_Initialize failed, error %lu.\n", GetLastError() );
+        IUsbDevice_Release( &impl->IUsbDevice_iface );
+        return hr;
+    }
+
+    if (WinUsb_QueryInterfaceSettings( impl->winusb, 0, &impl->iface_desc ))
+    {
+        UCHAR i;
+        for (i = 0; i < impl->iface_desc.bNumEndpoints && i < ARRAY_SIZE(impl->pipes); i++)
+        {
+            if (!WinUsb_QueryPipe( impl->winusb, 0, i, &impl->pipes[i] )) break;
+            impl->pipe_count++;
+        }
+    }
+    else WARN( "WinUsb_QueryInterfaceSettings failed, error %lu.\n", GetLastError() );
+
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)&impl->IUsbDevice_iface;
+    return S_OK;
+}
