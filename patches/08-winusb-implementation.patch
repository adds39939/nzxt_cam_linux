 #include <stdarg.h>
+#include <stdlib.h>
 
 #include "windef.h"
 #include "winbase.h"
+#include "ddk/usb100.h"
 #include "winusb.h"
+#include "wine/wineusb.h"
 
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(winusb);
 
+struct winusb_handle
+{
+    HANDLE file;
+    UCHAR *config;          /* configuration descriptor, with all interfaces */
+    ULONG config_len;
+    UCHAR interface_index;  /* which interface of the configuration this handle drives */
+    UCHAR alt_setting;
+};
+
+/* Issue one URB through wineusb.sys. On entry *len is the payload size; on
+ * return it is the number of bytes actually transferred. */
+static BOOL submit_urb( struct winusb_handle *device, struct wineusb_urb_request *req,
+                        void *buffer, ULONG *len )
+{
+    ULONG size = sizeof(*req) + *len, returned = 0;
+    struct wineusb_urb_request *msg;
+    BOOL ret;
+
+    if (!(msg = malloc( size )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    *msg = *req;
+    msg->transfer_length = *len;
+    if (*len && buffer && !(req->flags & WINEUSB_TRANSFER_IN))
+        memcpy( msg + 1, buffer, *len );
+
+    ret = DeviceIoControl( device->file, IOCTL_WINEUSB_SUBMIT_URB, msg, size, msg, size, &returned, NULL );
+    if (ret)
+    {
+        *len = msg->transfer_length;
+        if (*len && buffer && (req->flags & WINEUSB_TRANSFER_IN))
+            memcpy( buffer, msg + 1, *len );
+    }
+    else
+    {
+        *len = 0;
+        WARN( "URB failed, error %lu.\n", GetLastError() );
+    }
+    free( msg );
+    return ret;
+}
+
+static BOOL get_descriptor( struct winusb_handle *device, UCHAR type, UCHAR index,
+                            USHORT lang, void *buffer, ULONG *len )
+{
+    struct wineusb_urb_request req = {0};
+
+    req.type = WINEUSB_URB_DESCRIPTOR;
+    req.flags = WINEUSB_TRANSFER_IN;
+    req.descriptor_type = type;
+    req.descriptor_index = index;
+    req.index = lang;
+    return submit_urb( device, &req, buffer, len );
+}
+
+/* Walk the configuration descriptor and return the interface descriptor for
+ * (index, alt), optionally reporting where it starts. */
+static const USB_INTERFACE_DESCRIPTOR *find_interface( struct winusb_handle *device,
+                                                       UCHAR index, UCHAR alt, ULONG *offset )
+{
+    ULONG pos = 0;
+
+    while (pos + 2 <= device->config_len)
+    {
+        const UCHAR *desc = device->config + pos;
+        UCHAR length = desc[0], type = desc[1];
+
+        if (!length || pos + length > device->config_len) break;
+        if (type == USB_INTERFACE_DESCRIPTOR_TYPE)
+        {
+            const USB_INTERFACE_DESCRIPTOR *iface = (const USB_INTERFACE_DESCRIPTOR *)desc;
+            if (iface->bInterfaceNumber == index && iface->bAlternateSetting == alt)
+            {
+                if (offset) *offset = pos;
+                return iface;
+            }
+        }
+        pos += length;
+    }
+    return NULL;
+}
+
+/***********************************************************************
+ *           WinUsb_Initialize (winusb.@)
+ */
+BOOL WINAPI WinUsb_Initialize( HANDLE file, PWINUSB_INTERFACE_HANDLE handle )
+{
+    UCHAR header[sizeof(USB_CONFIGURATION_DESCRIPTOR)];
+    struct winusb_handle *device;
+    ULONG len;
+
+    TRACE( "file %p, handle %p.\n", file, handle );
+
+    if (!handle)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *handle = NULL;
+    if (!file || file == INVALID_HANDLE_VALUE)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+
+    if (!(device = calloc( 1, sizeof(*device) )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    device->file = file;
+
+    /* Read the configuration descriptor header to learn its full length. */
+    len = sizeof(header);
+    if (!get_descriptor( device, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0, 0, header, &len )
+        || len < sizeof(USB_CONFIGURATION_DESCRIPTOR))
+    {
+        WARN( "Failed to read configuration descriptor header.\n" );
+        free( device );
+        SetLastError( ERROR_GEN_FAILURE );
+        return FALSE;
+    }
+
+    device->config_len = ((const USB_CONFIGURATION_DESCRIPTOR *)header)->wTotalLength;
+    if (!(device->config = malloc( device->config_len )))
+    {
+        free( device );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    len = device->config_len;
+    if (!get_descriptor( device, USB_CONFIGURATION_DESCRIPTOR_TYPE, 0, 0, device->config, &len ))
+    {
+        WARN( "Failed to read configuration descriptor.\n" );
+        free( device->config );
+        free( device );
+        SetLastError( ERROR_GEN_FAILURE );
+        return FALSE;
+    }
+    device->config_len = len;
+
+    TRACE( "Opened device, configuration descriptor is %lu bytes.\n", device->config_len );
+    *handle = device;
+    return TRUE;
+}
+
 /***********************************************************************
  *           WinUsb_Free (winusb.@)
  */
-BOOL WINAPI WinUsb_Free(WINUSB_INTERFACE_HANDLE handle)
+BOOL WINAPI WinUsb_Free( WINUSB_INTERFACE_HANDLE handle )
+{
+    struct winusb_handle *device = handle;
+
+    TRACE( "handle %p.\n", handle );
+
+    if (device)
+    {
+        free( device->config );
+        free( device );
+    }
+    return TRUE;
+}
+
+BOOL WINAPI WinUsb_GetAssociatedInterface( WINUSB_INTERFACE_HANDLE handle, UCHAR index,
+                                           PWINUSB_INTERFACE_HANDLE assoc )
+{
+    struct winusb_handle *device = handle, *iface;
+
+    TRACE( "handle %p, index %u, assoc %p.\n", handle, index, assoc );
+
+    if (!device || !assoc)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *assoc = NULL;
+
+    /* index is relative to the current interface */
+    if (!find_interface( device, device->interface_index + index + 1, 0, NULL ))
+    {
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return FALSE;
+    }
+    if (!(iface = calloc( 1, sizeof(*iface) )))
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    iface->file = device->file;
+    iface->interface_index = device->interface_index + index + 1;
+    if (!(iface->config = malloc( device->config_len )))
+    {
+        free( iface );
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    memcpy( iface->config, device->config, device->config_len );
+    iface->config_len = device->config_len;
+
+    *assoc = iface;
+    return TRUE;
+}
+
+BOOL WINAPI WinUsb_QueryInterfaceSettings( WINUSB_INTERFACE_HANDLE handle, UCHAR alt,
+                                           PUSB_INTERFACE_DESCRIPTOR desc )
+{
+    struct winusb_handle *device = handle;
+    const USB_INTERFACE_DESCRIPTOR *iface;
+
+    TRACE( "handle %p, alt %u, desc %p.\n", handle, alt, desc );
+
+    if (!device || !desc)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(iface = find_interface( device, device->interface_index, alt, NULL )))
+    {
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return FALSE;
+    }
+    *desc = *iface;
+    return TRUE;
+}
+
+BOOL WINAPI WinUsb_QueryPipe( WINUSB_INTERFACE_HANDLE handle, UCHAR alt, UCHAR index,
+                              PWINUSB_PIPE_INFORMATION info )
+{
+    struct winusb_handle *device = handle;
+    const USB_INTERFACE_DESCRIPTOR *iface;
+    ULONG offset, pos, found = 0;
+
+    TRACE( "handle %p, alt %u, index %u, info %p.\n", handle, alt, index, info );
+
+    if (!device || !info)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(iface = find_interface( device, device->interface_index, alt, &offset )))
+    {
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return FALSE;
+    }
+
+    pos = offset + iface->bLength;
+    while (pos + 2 <= device->config_len)
+    {
+        const UCHAR *desc = device->config + pos;
+        UCHAR length = desc[0], type = desc[1];
+
+        if (!length || pos + length > device->config_len) break;
+        if (type == USB_INTERFACE_DESCRIPTOR_TYPE) break;   /* next interface */
+        if (type == USB_ENDPOINT_DESCRIPTOR_TYPE)
+        {
+            const USB_ENDPOINT_DESCRIPTOR *ep = (const USB_ENDPOINT_DESCRIPTOR *)desc;
+
+            if (found++ == index)
+            {
+                info->PipeId = ep->bEndpointAddress;
+                info->MaximumPacketSize = ep->wMaxPacketSize;
+                info->Interval = ep->bInterval;
+                switch (ep->bmAttributes & 3)
+                {
+                    case 0:  info->PipeType = UsbdPipeTypeControl; break;
+                    case 1:  info->PipeType = UsbdPipeTypeIsochronous; break;
+                    case 2:  info->PipeType = UsbdPipeTypeBulk; break;
+                    default: info->PipeType = UsbdPipeTypeInterrupt; break;
+                }
+                TRACE( "pipe %u: id %#x, type %u, packet size %u.\n",
+                       index, info->PipeId, info->PipeType, info->MaximumPacketSize );
+                return TRUE;
+            }
+        }
+        pos += length;
+    }
+
+    SetLastError( ERROR_NO_MORE_ITEMS );
+    return FALSE;
+}
+
+BOOL WINAPI WinUsb_ControlTransfer( WINUSB_INTERFACE_HANDLE handle, WINUSB_SETUP_PACKET setup,
+                                    PUCHAR buffer, ULONG length, PULONG transferred,
+                                    LPOVERLAPPED overlapped )
+{
+    struct winusb_handle *device = handle;
+    struct wineusb_urb_request req = {0};
+    ULONG len = length;
+    BOOL ret;
+
+    TRACE( "handle %p, type %#x, request %#x, value %#x, index %#x, length %lu.\n",
+           handle, setup.RequestType, setup.Request, setup.Value, setup.Index, length );
+
+    if (overlapped) FIXME( "Overlapped I/O is not supported.\n" );
+    if (!device)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+
+    req.type = WINEUSB_URB_CONTROL;
+    req.request_type = setup.RequestType;
+    req.request = setup.Request;
+    req.value = setup.Value;
+    req.index = setup.Index;
+    if (setup.RequestType & 0x80) req.flags |= WINEUSB_TRANSFER_IN;
+
+    ret = submit_urb( device, &req, buffer, &len );
+    if (transferred) *transferred = len;
+    return ret;
+}
+
+/* Endpoints may be bulk or interrupt; the Unix backend picks the libusb transfer
+ * type from the pipe handle, so report the real one. */
+static UCHAR pipe_type_for_endpoint( struct winusb_handle *device, UCHAR endpoint )
+{
+    ULONG pos = 0;
+
+    while (pos + 2 <= device->config_len)
+    {
+        const UCHAR *desc = device->config + pos;
+        UCHAR length = desc[0], type = desc[1];
+
+        if (!length || pos + length > device->config_len) break;
+        if (type == USB_ENDPOINT_DESCRIPTOR_TYPE)
+        {
+            const USB_ENDPOINT_DESCRIPTOR *ep = (const USB_ENDPOINT_DESCRIPTOR *)desc;
+
+            if (ep->bEndpointAddress == endpoint)
+                return (ep->bmAttributes & 3) == 3 ? UsbdPipeTypeInterrupt : UsbdPipeTypeBulk;
+        }
+        pos += length;
+    }
+    return UsbdPipeTypeBulk;
+}
+
+static BOOL transfer_pipe( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id, PUCHAR buffer,
+                           ULONG length, PULONG transferred, LPOVERLAPPED overlapped, BOOL in )
+{
+    struct winusb_handle *device = handle;
+    struct wineusb_urb_request req = {0};
+    ULONG len = length;
+    BOOL ret;
+
+    if (overlapped) FIXME( "Overlapped I/O is not supported.\n" );
+    if (!device)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+
+    req.type = WINEUSB_URB_BULK;
+    req.endpoint = pipe_id;
+    req.pipe_type = pipe_type_for_endpoint( device, pipe_id );
+    if (in) req.flags |= WINEUSB_TRANSFER_IN;
+
+    ret = submit_urb( device, &req, buffer, &len );
+    if (transferred) *transferred = len;
+    return ret;
+}
+
+BOOL WINAPI WinUsb_ReadPipe( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id, PUCHAR buffer,
+                             ULONG length, PULONG transferred, LPOVERLAPPED overlapped )
+{
+    TRACE( "handle %p, pipe %#x, length %lu.\n", handle, pipe_id, length );
+    return transfer_pipe( handle, pipe_id, buffer, length, transferred, overlapped, TRUE );
+}
+
+BOOL WINAPI WinUsb_WritePipe( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id, PUCHAR buffer,
+                              ULONG length, PULONG transferred, LPOVERLAPPED overlapped )
+{
+    TRACE( "handle %p, pipe %#x, length %lu.\n", handle, pipe_id, length );
+    return transfer_pipe( handle, pipe_id, buffer, length, transferred, overlapped, FALSE );
+}
+
+BOOL WINAPI WinUsb_GetDescriptor( WINUSB_INTERFACE_HANDLE handle, UCHAR type, UCHAR index,
+                                  USHORT lang, PUCHAR buffer, ULONG length, PULONG transferred )
+{
+    struct winusb_handle *device = handle;
+    ULONG len = length;
+    BOOL ret;
+
+    TRACE( "handle %p, type %#x, index %u, lang %#x, length %lu.\n", handle, type, index, lang, length );
+
+    if (!device)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    ret = get_descriptor( device, type, index, lang, buffer, &len );
+    if (transferred) *transferred = len;
+    return ret;
+}
+
+static BOOL pipe_request( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id, ULONG type )
 {
-    FIXME( "(%p) - stub\n", handle );
+    struct winusb_handle *device = handle;
+    struct wineusb_urb_request req = {0};
+    ULONG len = 0;
+
+    if (!device)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    req.type = type;
+    req.endpoint = pipe_id;
+    req.pipe_type = pipe_type_for_endpoint( device, pipe_id );
+    return submit_urb( device, &req, NULL, &len );
+}
+
+BOOL WINAPI WinUsb_ResetPipe( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id )
+{
+    TRACE( "handle %p, pipe %#x.\n", handle, pipe_id );
+    return pipe_request( handle, pipe_id, WINEUSB_URB_RESET_PIPE );
+}
+
+BOOL WINAPI WinUsb_AbortPipe( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id )
+{
+    TRACE( "handle %p, pipe %#x.\n", handle, pipe_id );
+    return pipe_request( handle, pipe_id, WINEUSB_URB_ABORT_PIPE );
+}
+
+BOOL WINAPI WinUsb_FlushPipe( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id )
+{
+    TRACE( "handle %p, pipe %#x.\n", handle, pipe_id );
     return TRUE;
 }
+
+BOOL WINAPI WinUsb_GetCurrentAlternateSetting( WINUSB_INTERFACE_HANDLE handle, PUCHAR setting )
+{
+    struct winusb_handle *device = handle;
+
+    TRACE( "handle %p, setting %p.\n", handle, setting );
+
+    if (!device || !setting)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *setting = device->alt_setting;
+    return TRUE;
+}
+
+BOOL WINAPI WinUsb_SetCurrentAlternateSetting( WINUSB_INTERFACE_HANDLE handle, UCHAR setting )
+{
+    struct winusb_handle *device = handle;
+
+    TRACE( "handle %p, setting %u.\n", handle, setting );
+
+    if (!device)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    device->alt_setting = setting;
+    return TRUE;
+}
+
+/* Policies only affect timeout/short-packet behaviour, which the Unix backend
+ * already handles; accept and ignore them rather than failing the caller. */
+BOOL WINAPI WinUsb_SetPipePolicy( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id, ULONG policy,
+                                  ULONG length, PVOID value )
+{
+    FIXME( "handle %p, pipe %#x, policy %#lx: ignored.\n", handle, pipe_id, policy );
+    return TRUE;
+}
+
+BOOL WINAPI WinUsb_GetPipePolicy( WINUSB_INTERFACE_HANDLE handle, UCHAR pipe_id, ULONG policy,
+                                  PULONG length, PVOID value )
+{
+    FIXME( "handle %p, pipe %#x, policy %#lx: stub.\n", handle, pipe_id, policy );
+    if (length && value && *length >= sizeof(ULONG)) memset( value, 0, sizeof(ULONG) );
+    return TRUE;
+}
