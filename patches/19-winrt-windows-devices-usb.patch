+    out_stream_QueryInterface,
+    out_stream_AddRef,
+    out_stream_Release,
+    out_stream_GetIids,
+    out_stream_GetRuntimeClassName,
+    out_stream_GetTrustLevel,
+    out_stream_WriteAsync,
+    out_stream_FlushAsync,
+};
