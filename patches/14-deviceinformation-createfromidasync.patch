 DEFINE_IINSPECTABLE( device_statics, IDeviceInformationStatics, struct device_information_statics, IActivationFactory_iface );
 
+static DEV_OBJECT_TYPE object_type_from_device_information_kind( DeviceInformationKind kind )
+{
+    switch (kind)
+    {
+    case DeviceInformationKind_DeviceInterface:               return DevObjectTypeDeviceInterfaceDisplay;
+    case DeviceInformationKind_DeviceContainer:               return DevObjectTypeDeviceContainerDisplay;
+    case DeviceInformationKind_Device:                        return DevObjectTypeDevice;
+    case DeviceInformationKind_DeviceInterfaceClass:          return DevObjectTypeDeviceInterfaceClass;
+    case DeviceInformationKind_AssociationEndpoint:           return DevObjectTypeAEP;
+    case DeviceInformationKind_AssociationEndpointContainer:  return DevObjectTypeAEPContainer;
+    case DeviceInformationKind_AssociationEndpointService:    return DevObjectTypeAEPService;
+    case DeviceInformationKind_DevicePanel:                   return DevObjectTypeDevicePanel;
+    default:                                                  return DevObjectTypeUnknown;
+    }
+}
+
+static HRESULT create_from_id_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct devquery_params *params;
+    const DEVPROPERTY *props = NULL;
+    IDeviceInformation *info;
+    ULONG props_len = 0;
+    DEV_OBJECT obj = {0};
+    HRESULT hr;
+
+    TRACE( "invoker %p, param %p, result %p, called_async %d\n", invoker, param, result, called_async );
+
+    if (!called_async) return STATUS_PENDING;
+
+    params = impl_from_IUnknown( param );
+    if (FAILED(hr = DevGetObjectProperties( params->type, params->id, DevQueryFlagNone, params->prop_keys_len,
+                                            params->prop_keys, &props_len, &props )))
+        return hr;
+
+    obj.ObjectType = params->type;
+    obj.pszObjectId = params->id;
+    obj.cPropertyCount = props_len;
+    obj.pProperties = props;
+    hr = device_information_create( &obj, &info );
+    DevFreeObjectProperties( props_len, props );
+    if (FAILED(hr)) return hr;
+
+    result->vt = VT_UNKNOWN;
+    result->punkVal = (IUnknown *)info;
+    return S_OK;
+}
+
+static HRESULT device_information_create_from_id_async( IUnknown *statics, HSTRING device_id,
+                                                        IIterable_HSTRING *additional_properties,
+                                                        DeviceInformationKind kind,
+                                                        IAsyncOperation_DeviceInformation **op )
+{
+    const DEVPROPCOMPKEY default_props[] = {
+        { DEVPKEY_Device_InstanceId, DEVPROP_STORE_SYSTEM, NULL },
+    };
+    DEVPROPCOMPKEY *prop_keys = NULL;
+    struct devquery_params *impl;
+    DEV_OBJECT_TYPE type;
+    ULONG prop_keys_len = 0;
+    const WCHAR *id_str;
+    IUnknown *params;
+    UINT32 id_len;
+    HRESULT hr;
+
+    if (!op) return E_POINTER;
+    *op = NULL;
+    if (!device_id) return E_INVALIDARG;
+    if ((type = object_type_from_device_information_kind( kind )) == DevObjectTypeUnknown) return E_INVALIDARG;
+
+    id_str = WindowsGetStringRawBuffer( device_id, &id_len );
+    if (!id_str || !id_len) return E_INVALIDARG;
+
+    if (FAILED(hr = devpropcompkeys_init( &prop_keys, &prop_keys_len, default_props, ARRAY_SIZE( default_props ) ))) goto failed;
+    if (additional_properties && FAILED(hr = devpropcompkeys_append_names( &prop_keys, &prop_keys_len, additional_properties ))) goto failed;
+    if (FAILED(hr = devquery_params_create( type, NULL, prop_keys, prop_keys_len, &params ))) goto failed;
+
+    impl = impl_from_IUnknown( params );
+    if (!(impl->id = wcsdup( id_str )))
+    {
+        IUnknown_Release( params );
+        return E_OUTOFMEMORY;
+    }
+
+    hr = async_operation_inspectable_create( &IID_IAsyncOperation_DeviceInformation, statics, params,
+                                             create_from_id_async, (IAsyncOperation_IInspectable **)op );
+    IUnknown_Release( params );
+    return hr;
+
+failed:
+    free( prop_keys );
+    return hr;
+}
+
