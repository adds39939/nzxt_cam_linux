+BOOL WINAPI WinUsb_GetOverlappedResult( WINUSB_INTERFACE_HANDLE handle, LPOVERLAPPED overlapped,
+                                        LPDWORD transferred, BOOL wait )
+{
+    struct winusb_handle *device = handle;
+
+    TRACE( "handle %p, overlapped %p, wait %d.\n", handle, overlapped, wait );
+
+    if (!device)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    return GetOverlappedResult( device->file, overlapped, transferred, wait );
+}
