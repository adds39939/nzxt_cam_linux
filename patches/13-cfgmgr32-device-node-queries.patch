+static LSTATUS copy_device_property( HKEY hkey, const struct device *dev, DEVPROPERTY *property )
+{
+    struct property prop;
+    LSTATUS err;
+
+    init_property( &prop, &property->CompKey.Key, &property->Type, property->Buffer, &property->BufferSize, TRUE );
+    if (!(err = query_device_property( hkey, dev, &prop ))) return ERROR_SUCCESS;
+    if (err && err != ERROR_MORE_DATA) return ERROR_SUCCESS;
+
+    if (!(prop.buffer = malloc( property->BufferSize ))) return ERROR_OUTOFMEMORY;
+    if ((err = query_device_property( hkey, dev, &prop ))) free( prop.buffer );
+    else property->Buffer = prop.buffer;
+
+    return err;
+}
+
+static LSTATUS copy_device_properties( HKEY hkey, const struct device *dev, const DEVPROPCOMPKEY *keys, ULONG keys_len,
+                                       DEVPROPERTY *properties, ULONG *props_len )
+{
+    const DEVPROPCOMPKEY *key, *end;
+    DEVPROPERTY *prop = properties;
+    LSTATUS err = ERROR_SUCCESS;
+
+    for (key = keys, end = keys + keys_len; !err && key < end; key++, prop++)
+    {
+        prop->CompKey = *key;
+        err = copy_device_property( hkey, dev, prop );
+    }
+    *props_len = prop - properties;
+
+    return err;
+}
+
+static LSTATUS copy_device_property_keys( HKEY hkey, const struct device *dev, const DEVPROPCOMPKEY **comp_keys, ULONG *comp_keys_len )
+{
+    DEVPROPKEY *tmp, *keys = NULL;
+    LSTATUS err;
+
+    for (;;)
+    {
+        if (!(err = enum_device_property_keys( hkey, dev, keys, comp_keys_len ))) break;
+        if (err != ERROR_MORE_DATA) { free( keys ); return err; }
+        if (!(tmp = realloc( keys, *comp_keys_len * sizeof(*keys) ))) { free( keys ); return ERROR_OUTOFMEMORY; }
+        keys = tmp;
+    }
+
+    get_property_compare_keys( keys, *comp_keys_len, comp_keys, comp_keys_len );
+    free( keys );
+    return ERROR_SUCCESS;
+}
