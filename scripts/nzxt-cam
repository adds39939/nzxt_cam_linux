#!/usr/bin/env bash
# Launch NZXT CAM in its patched Wine prefix.
#
#   nzxt-cam            supervise CAM
#   nzxt-cam --startup  what the autostart entry passes; CAM's own "Start minimized"
#                       setting is what then sends it to the tray
#   nzxt-cam --setup    (re)run the first-run install and exit
#
# Anything else is handed to CAM, nzxt-cam:// deep links included.
#
# Wine lives in /app and is already patched -- the two kernel drivers are in
# /app/lib/wine/x86_64-windows where Wine maps them from, and the patched user-mode
# DLLs are its own builtins. Nothing has to be injected into the prefix, so this
# script only has to deal with what changes at runtime.
set -uo pipefail

export WINEPREFIX="${WINEPREFIX:-${XDG_DATA_HOME:-$HOME/.local/share}/wineprefix}"

CAMDIR="$WINEPREFIX/drive_c/Program Files/NZXT CAM"
LOG="$WINEPREFIX/nzxt-cam.log"
LOCK="$WINEPREFIX/.nzxt-cam.lock"
# Touched by a second launch to ask the running one to show its window. See
# request_raise() for why a second launch cannot do that itself.
RAISE="$WINEPREFIX/.nzxt-cam.raise"
TOOLS="${NZXT_CAM_TOOLS:-/app/share/nzxt-cam}"

args=()
for a in "$@"; do
  case "$a" in
    -h|--help)   sed -n '2,9p' "$0" | cut -c3-; exit 0 ;;
    --setup)     exec nzxt-cam-setup ;;
    *)           args+=("$a") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

mkdir -p "$WINEPREFIX"

# ----------------------------------------------------------------- one at a time

# Only one launcher at a time. Each one supervises CAM and refreshes the GPU readings,
# so a second fights the first over restarts and over that file -- which looks like
# readings that flicker or go stale for no reason.
#
# Probe the lock rather than take it, so that taking it below is still possible.
lock_held() {
  ! ( { exec 9>"$LOCK"; } 2>/dev/null || exit 0; flock -n 9 ) 2>/dev/null
}

# Bringing the running copy to the front is normally a matter of starting CAM again:
# Electron's single-instance lock means the second one hands its arguments to the
# first and exits, and unlike poking at the window that works from the tray, and on
# Wayland.
#
# It cannot be done from here. Every `flatpak run` is a fresh sandbox with its own
# PID namespace and its own /tmp, and Wine's server socket lives in /tmp -- so a
# second instance would not find the running wineserver, it would start a SECOND one
# against the same prefix. Two wineservers on one prefix is how a prefix gets
# corrupted. Ask the instance that owns the prefix to do it instead.
request_raise() {
  : > "$RAISE" 2>/dev/null || return 1
  return 0
}

if lock_held; then
  if request_raise; then
    echo "nzxt-cam: already running -- asked it to show its window"
  else
    echo "nzxt-cam: already running" >&2
  fi
  exit 0
fi

# Take it for real. Note the braces: "exec 9>file 2>/dev/null" would apply that second
# redirection to the shell as well, and silently throw away every message from here on.
locked=1
if { exec 9>"$LOCK"; } 2>/dev/null; then
  flock -n 9 || locked=0
fi
if [ "$locked" = 0 ]; then
  # Lost the race with another launcher started at the same moment.
  request_raise
  echo "nzxt-cam: already running" >&2
  exit 0
fi
rm -f "$RAISE"

# Everything from here writes to that log, so trim it before it grows without end.
[ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] && : > "$LOG"

# ------------------------------------------------------------------- first run

# CAM is not redistributed -- it is downloaded from NZXT and installed into the prefix
# the first time this runs.
if [ ! -d "$CAMDIR" ]; then
  nzxt-cam-setup || { echo "nzxt-cam: setup failed -- see $LOG" >&2; exit 1; }
fi
[ -d "$CAMDIR" ] || { echo "nzxt-cam: CAM is not installed" >&2; exit 1; }

# -------------------------------------------------------------- device access

# NZXT devices stay owned by root until a udev rule says otherwise, and no Flatpak can
# install one. Without it CAM starts and looks entirely normal while Cooling and
# Lighting stay empty, which gives no hint at all where to look -- so say so, once,
# somewhere the user will actually see it.
check_device_access() {
  local dev found=0
  for dev in /sys/bus/hid/devices/*; do
    case "${dev##*/}" in *:1E71:*|*:1e71:*) found=1; break ;; esac
  done
  [ "$found" = 1 ] || return 0          # no NZXT device attached; nothing to say

  for dev in /dev/hidraw*; do
    [ -r "$dev" ] && [ -w "$dev" ] && return 0
  done

  echo "nzxt-cam: an NZXT device is attached but no /dev/hidraw* is accessible." >&2
  echo "nzxt-cam: CAM will start and detect nothing. Install the udev rule:" >&2
  echo "nzxt-cam:   sudo cp $TOOLS/60-nzxt-cam.rules /etc/udev/rules.d/" >&2
  echo "nzxt-cam:   sudo udevadm control --reload-rules" >&2
  echo "nzxt-cam:   sudo udevadm trigger --subsystem-match=hidraw --subsystem-match=usb" >&2
  notify-send -a "NZXT CAM" -u critical "NZXT CAM cannot reach your device" \
    "A udev rule is needed. Run:  flatpak run --command=nzxt-cam-setup io.github.adds39939.NzxtCamLinux --udev-help" \
    2>/dev/null || true
}
check_device_access

# ---------------------------------------------------------------------- scale

# CAM always renders at 100%, so on a scaled display it comes out small. Scaling goes
# through Wine's DPI, which Chromium reports as its device pixel ratio.
#
# Do NOT scale with --force-device-scale-factor instead. It sizes the window correctly
# but stops cam-core from starting, so no NZXT device is ever detected -- the UI looks
# perfectly fine while the Cooling and Lighting pages stay empty.
#
# kscreen-doctor and friends are not in the sandbox, so the scale comes from the
# settings portal, which both GNOME and KDE answer. Override it for good with:
#   flatpak override --user --env=NZXT_CAM_SCALE=1.5 io.github.adds39939.NzxtCamLinux
# gdbus prints a ReadOne result as its full variant -- "(<uint32 1>,)" for an integer,
# "(<1.0>,)" for a double. Unwrap it and drop the type name; grepping for digits would
# find the 32 in "uint32".
portal_read() {                 # portal_read <namespace> <key>
  gdbus call --session --dest org.freedesktop.portal.Desktop \
      --object-path /org/freedesktop/portal/desktop \
      --method org.freedesktop.portal.Settings.ReadOne "$1" "$2" 2>/dev/null \
    | sed -n 's/^(<\(.*\)>,)$/\1/p' \
    | sed 's/^[a-z0-9]* //'
}

# What GTK itself does: an integer window scale times a fractional text scale. A
# desktop that answers neither leaves both at 1.
desktop_scale() {
  local factor text
  factor="$(portal_read org.gnome.desktop.interface scaling-factor)"
  text="$(portal_read org.gnome.desktop.interface text-scaling-factor)"
  awk -v f="${factor:-1}" -v t="${text:-1}" \
      'BEGIN { if (f < 1) f = 1; if (t < 0.5) t = 1; printf "%.4f", f * t }'
}

apply_scale() {
  local scale dpi cur
  scale="${NZXT_CAM_SCALE:-$(desktop_scale)}"
  dpi=$(awk -v s="$scale" 'BEGIN{printf "%d", (s*96)+0.5}')
  [ "$dpi" -ge 96 ] 2>/dev/null || return 0
  cur=$(wine reg query 'HKCU\Control Panel\Desktop' /v LogPixels 2>/dev/null \
        | awk '/LogPixels/{print strtonum($NF)}')
  # An unset LogPixels already means 96, so do not write it just to say so -- that
  # would bounce the wineserver on every first launch for no change at all.
  [ -z "${cur:-}" ] && [ "$dpi" = 96 ] && return 0
  if [ "$dpi" != "${cur:-}" ]; then
    wine reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$dpi" /f >/dev/null 2>&1
    wineserver -w
  fi
}

# --------------------------------------------------------------- device fixups

# Wine's PnP manager rebuilds the device tree (and rewrites DEVPKEY_Device_Parent)
# every time the server starts, so these have to be re-applied after enumeration and
# before CAM looks for its device -- including after the crash restart below, which
# stops the server. Give plugplay a moment to settle first, otherwise the interfaces
# are not in the registry yet.
apply_device_fixups() {
  if [ -f "$TOOLS/usbtree-fixup.exe" ]; then
    wine cmd /c exit >/dev/null 2>&1
    sleep 3
    wine "$TOOLS/usbtree-fixup.exe" >/dev/null 2>&1
  fi
  # Wine registers the GPU but leaves its PCI location unset, and CAM drops any
  # adapter whose BusNumber/Address it cannot read. Fill them in from the host.
  [ -f "$TOOLS/gpu-pci-fixup.exe" ] && wine "$TOOLS/gpu-pci-fixup.exe" >/dev/null 2>&1
  return 0
}

# ----------------------------------------------------------------- crash guard

# The Capture Card page kills CAM's renderer under Wine (exit code 0xC0000409): it
# needs a COM class Wine does not implement. CAM restores the last page on launch and
# gives up after two crashes, so one click otherwise leaves the app blank for good.
#
# Two halves to the guard: send the stored route back to the dashboard before starting,
# and watch for CAM's own "crash threshold" message while it runs, so a click during
# the session recovers by itself instead of needing a manual relaunch.
reset_fatal_route() {
  local router
  for router in "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/"NZXT CAM"/DataStorage/latest/local/router.json; do
    [ -f "$router" ] || continue
    if grep -q '"/capture"' "$router" 2>/dev/null; then
      printf '{"pathname":"/"}\n' > "$router"
    fi
  done
}

cam_log_path() {
  local f
  for f in "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/"NZXT CAM"/logs/main.log; do
    [ -e "$f" ] && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# ------------------------------------------------------------------- shutdown

cleanup() {
  trap - EXIT INT TERM
  [ -n "${poller:-}" ] && kill "$poller" 2>/dev/null
  [ -n "${raiser:-}" ] && kill "$raiser" 2>/dev/null
  if [ -n "${cam:-}" ] && kill -0 "$cam" 2>/dev/null; then
    kill "$cam" 2>/dev/null
    for _ in 1 2 3 4 5; do kill -0 "$cam" 2>/dev/null || break; sleep 1; done
  fi
  wineserver -k >/dev/null 2>&1 || true
  rm -f "$RAISE"

  # Once more on the way out, now that stopping the wineserver has flushed the
  # registry: a "start with Windows" flipped during this session is on disk by this
  # point, and picking it up here is what stops the change waiting for the next launch.
  timeout 10 nzxt-cam-autostart sync >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------- start

# CAM's own "start with Windows" switch writes to the prefix's Run key, which Wine only
# acts on when a Wine session starts -- and nothing starts one when you log in to
# Linux. Make the switch mean something by mirroring it onto the Linux side. Once here
# and once on the way out, which between them cover a switch flipped while CAM was
# running and one flipped in a session that has since ended.
nzxt-cam-autostart sync >/dev/null 2>&1 || true

# The shim cannot read the GPU from inside the prefix, so refresh the readings into a
# file it can. The poller works out where to get them: the kernel's hwmon and DRM
# interfaces for AMD, Intel and nouveau, NVML for NVIDIA's proprietary driver.
GPU_STATE="$WINEPREFIX/drive_c/windows/temp/nzxt-cam-gpu"
mkdir -p "$(dirname "$GPU_STATE")"
nzxt-cam-gpu-poll "$GPU_STATE" 2 >/dev/null 2>&1 &
poller=$!

# Answer the raise requests a second launch leaves behind. Runs in this sandbox, so
# it reaches this instance's wineserver and CAM's single-instance lock.
raise_watcher() {
  while :; do
    if [ -e "$RAISE" ]; then
      rm -f "$RAISE"
      if pgrep -f 'NZXT CAM\.exe' >/dev/null 2>&1; then
        ( cd "$CAMDIR" && timeout 30 wine "NZXT CAM.exe" ) >/dev/null 2>&1 || true
      fi
    fi
    sleep 1
  done
}
raise_watcher &
raiser=$!

cd "$CAMDIR" || exit 1
apply_scale

attempt=0
while :; do
  reset_fatal_route
  apply_device_fixups

  # Only look at log lines this run appends, not a previous session's.
  cam_log="$(cam_log_path || true)"
  offset=0
  [ -n "$cam_log" ] && offset=$(wc -c < "$cam_log")

  wine "NZXT CAM.exe" "$@" &
  cam=$!

  crashed=0
  while kill -0 "$cam" 2>/dev/null; do
    [ -n "$cam_log" ] || cam_log="$(cam_log_path || true)"
    if [ -n "$cam_log" ] &&
       tail -c "+$((offset + 1))" "$cam_log" 2>/dev/null | grep -q "Crash threshold reached"; then
      crashed=1
      break
    fi
    sleep 2
  done

  if [ "$crashed" -eq 1 ] && [ "$attempt" -lt 2 ]; then
    attempt=$((attempt + 1))
    echo "nzxt-cam: CAM's renderer crash-looped (the Capture Card page does that under" >&2
    echo "nzxt-cam: Wine). Restarting on the dashboard." >&2
    wineserver -k 2>/dev/null || true
    sleep 3
    continue
  fi

  wait "$cam" 2>/dev/null
  break
done
