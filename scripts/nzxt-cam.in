#!/usr/bin/env bash
# Launch NZXT CAM in its patched Wine prefix.
export WINEPREFIX="__PREFIX__"

# Wine's PnP manager rebuilds the device tree (and rewrites DEVPKEY_Device_Parent)
# every time the server starts, so the USB composite-device fixup has to be applied
# after enumeration and before CAM looks for its device. Give plugplay a moment to
# settle first, otherwise the interfaces are not in the registry yet.
FIXUP="$WINEPREFIX/drive_c/windows/system32/usbtree-fixup.exe"
if [ -f "$FIXUP" ]; then
  wine cmd /c exit >/dev/null 2>&1
  sleep 3
  wine "$FIXUP" >/dev/null 2>&1
fi

# Wine registers the GPU but leaves its PCI location unset, and CAM drops any
# adapter whose BusNumber/Address it cannot read. Fill them in from the host.
GPUFIX="$WINEPREFIX/drive_c/windows/system32/gpu-pci-fixup.exe"
[ -f "$GPUFIX" ] && wine "$GPUFIX" >/dev/null 2>&1

# Scaling goes through Wine's DPI, which Chromium reports as its device pixel ratio;
# setup.sh sets it from the desktop scale. NZXT_CAM_SCALE re-points it here.
#
# Do NOT scale with --force-device-scale-factor instead. It sizes the window
# correctly but stops cam-core from starting, so no NZXT device is ever detected --
# the UI looks perfectly fine while the Cooling and Lighting pages stay empty.
if [ -n "${NZXT_CAM_SCALE:-}" ]; then
  dpi=$(awk -v s="$NZXT_CAM_SCALE" 'BEGIN{printf "%d", (s*96)+0.5}')
  cur=$(wine reg query 'HKCU\Control Panel\Desktop' /v LogPixels 2>/dev/null \
        | awk '/LogPixels/{print strtonum($NF)}')
  if [ "$dpi" != "$cur" ]; then
    wine reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$dpi" /f >/dev/null 2>&1
    wineserver -w
  fi
fi

# CAM restores the last page it was on. The Capture Card page kills the renderer
# under Wine (exit code 0xC0000409), and because the route is restored on every
# launch, one click leaves the app permanently stuck on a blank page. Send it back
# to the dashboard rather than let it reload the crash. Add other routes here if
# any turn out to be as fatal.
for router in "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/"NZXT CAM"/DataStorage/latest/local/router.json; do
  [ -f "$router" ] || continue
  if grep -q '"/capture"' "$router" 2>/dev/null; then
    printf '{"pathname":"/"}\n' > "$router"
  fi
done

# NVIDIA exposes no hwmon node, so the shim cannot read the GPU itself. Refresh
# the readings into a file it can: temperature C, load %, clock MHz, fan %, power W.
GPU_STATE="$WINEPREFIX/drive_c/windows/temp/nzxt-cam-gpu"
if command -v nvidia-smi >/dev/null 2>&1; then
  mkdir -p "$(dirname "$GPU_STATE")"
  (
    while :; do
      nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,clocks.gr,fan.speed,power.draw \
                 --format=csv,noheader,nounits > "$GPU_STATE.tmp" 2>/dev/null \
        && mv -f "$GPU_STATE.tmp" "$GPU_STATE"
      sleep 2
    done
  ) &
  trap 'kill $! 2>/dev/null' EXIT
fi

cd "$WINEPREFIX/drive_c/Program Files/NZXT CAM" || exit 1
exec wine "NZXT CAM.exe" "$@"
