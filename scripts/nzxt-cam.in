#!/usr/bin/env bash
# Launch NZXT CAM in its patched Wine prefix.
#
#   nzxt-cam            supervise CAM in this terminal
#   nzxt-cam -d         the same, detached -- the terminal comes straight back
#   nzxt-cam --startup  what the login unit passes; CAM's own "Start minimized"
#                       setting is what then sends it to the tray
#
# Anything else is handed to CAM, nzxt-cam:// deep links included.
export WINEPREFIX="__PREFIX__"
CAMDIR="$WINEPREFIX/drive_c/Program Files/NZXT CAM"
LOG="$WINEPREFIX/nzxt-cam.log"
LOCK="$WINEPREFIX/.nzxt-cam.lock"

detach=0
args=()
for a in "$@"; do
  case "$a" in
    -d|--detach) detach=1 ;;
    -h|--help)   sed -n '2,7p' "$0" | cut -c3-; exit 0 ;;
    *)           args+=("$a") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

# Only one launcher at a time. Each one supervises CAM and refreshes the GPU readings,
# so a second fights the first over restarts and over that file -- which looks like
# readings that flicker or go stale for no reason.
#
# Probe the lock rather than take it: this shell may be about to hand over to a
# detached copy of itself, and a lock held here is one that copy could not take.
lock_held() {
  command -v flock >/dev/null 2>&1 || return 1
  ! ( { exec 9>"$LOCK"; } 2>/dev/null || exit 0; flock -n 9 ) 2>/dev/null
}

# Bring the running copy to the front, which is what starting CAM again should do.
#
# Starting a second copy is how that is asked for: CAM takes Electron's single-instance
# lock, so the second one does not become a second CAM -- it hands its arguments to the
# first, which restores its window and takes focus, and then exits. That path works
# under Wine, and unlike poking at the X window it also works while CAM is sitting in
# the tray, on Wayland, and it leaves Electron's own idea of the window state intact.
#
# Guarded on CAM actually running: with no instance to answer, the same command would
# start one, unsupervised and outside the lock. The timeout is the backstop for that.
cam_is_up()  { pgrep -f 'NZXT CAM\.exe' >/dev/null 2>&1; }
raise_running_cam() {
  [ -d "$CAMDIR" ] || return 1
  local run=(wine "NZXT CAM.exe")
  command -v timeout >/dev/null 2>&1 && run=(timeout 30 "${run[@]}")
  ( cd "$CAMDIR" && exec "${run[@]}" "$@" ) >/dev/null 2>&1
}

if lock_held; then
  if ! cam_is_up; then
    echo "nzxt-cam: already running (still starting up)" >&2
  elif raise_running_cam "$@"; then
    echo "nzxt-cam: already running -- brought its window to the front"
  else
    echo "nzxt-cam: already running, but its window would not come to the front" >&2
  fi
  exit 0
fi

if [ "$detach" = 1 ] && [ -z "${NZXT_CAM_DETACHED:-}" ]; then
  runner=nohup
  command -v setsid >/dev/null 2>&1 && runner=setsid   # its own session: survives the terminal
  NZXT_CAM_DETACHED=1 "$runner" "$0" "$@" >>"$LOG" 2>&1 </dev/null &
  disown 2>/dev/null || true
  echo "nzxt-cam: running in the background (log: $LOG)"
  exit 0
fi

# Now take it for real. Note the braces: "exec 9>file 2>/dev/null" would apply that
# second redirection to the shell as well, and silently throw away every message from
# here on -- including the ones this script prints when something has gone wrong.
locked=1
if command -v flock >/dev/null 2>&1 && { exec 9>"$LOCK"; } 2>/dev/null; then
  flock -n 9 || locked=0
fi
if [ "$locked" = 0 ]; then
  # Lost the race with another launcher started at the same moment.
  cam_is_up && raise_running_cam "$@"
  echo "nzxt-cam: already running" >&2
  exit 0
fi

# Everything from here writes to that log -- this shell when detached, systemd's
# append: when started from the unit -- so trim it before it grows without end.
[ -f "$LOG" ] && [ "$(stat -c %s "$LOG" 2>/dev/null || echo 0)" -gt 1048576 ] && : > "$LOG"

# Wine regenerates its menu shortcuts whenever it reprocesses CAM's .lnk, and those run
# CAM directly, with none of what this script does for it. Put any that came back
# pointing here again, and take away any desktop shortcut that came with them.
if [ -x "$HOME/.local/bin/nzxt-cam-desktop-entries" ]; then
  NZXT_CAM_QUIET=1 "$HOME/.local/bin/nzxt-cam-desktop-entries" "$WINEPREFIX" >/dev/null 2>&1 || true
fi

# CAM's own "start with Windows" switch writes to the prefix's Run key, which Wine only
# acts on when a Wine session starts -- and nothing starts one when you log in to
# Linux. Make the switch mean something by mirroring it onto the Linux side.
if [ -x "$HOME/.local/bin/nzxt-cam-autostart" ]; then
  "$HOME/.local/bin/nzxt-cam-autostart" sync >/dev/null 2>&1 || true
fi

# Wine's PnP manager rebuilds the device tree (and rewrites DEVPKEY_Device_Parent)
# every time the server starts, so these have to be re-applied after enumeration and
# before CAM looks for its device -- including after the restart below, which stops
# the server. Give plugplay a moment to settle first, otherwise the interfaces are
# not in the registry yet.
apply_device_fixups() {
  local fixup="$WINEPREFIX/drive_c/windows/system32/usbtree-fixup.exe"
  local gpufix="$WINEPREFIX/drive_c/windows/system32/gpu-pci-fixup.exe"

  if [ -f "$fixup" ]; then
    wine cmd /c exit >/dev/null 2>&1
    sleep 3
    wine "$fixup" >/dev/null 2>&1
  fi

  # Wine registers the GPU but leaves its PCI location unset, and CAM drops any
  # adapter whose BusNumber/Address it cannot read. Fill them in from the host.
  [ -f "$gpufix" ] && wine "$gpufix" >/dev/null 2>&1
}

# Scaling goes through Wine's DPI, which Chromium reports as its device pixel ratio;
# setup.sh sets it from the desktop scale. NZXT_CAM_SCALE re-points it here.
#
# Do NOT scale with --force-device-scale-factor instead. It sizes the window
# correctly but stops cam-core from starting, so no NZXT device is ever detected --
# the UI looks perfectly fine while the Cooling and Lighting pages stay empty.
if [ -n "${NZXT_CAM_SCALE:-}" ]; then
  dpi=$(awk -v s="$NZXT_CAM_SCALE" 'BEGIN{printf "%d", (s*96)+0.5}')
  cur=$(wine reg query 'HKCU\Control Panel\Desktop' /v LogPixels 2>/dev/null \
        | awk '/LogPixels/{print strtonum($NF)}')
  if [ "$dpi" != "$cur" ]; then
    wine reg add 'HKCU\Control Panel\Desktop' /v LogPixels /t REG_DWORD /d "$dpi" /f >/dev/null 2>&1
    wineserver -w
  fi
fi

# The Capture Card page kills CAM's renderer under Wine (exit code 0xC0000409): it
# needs a COM class Wine does not implement. CAM restores the last page on launch and
# gives up after two crashes, so one click otherwise leaves the app blank for good.
#
# Two halves to the guard: send the stored route back to the dashboard before
# starting, and watch for CAM's own "crash threshold" message while it runs, so a
# click during the session recovers by itself instead of needing a manual relaunch.
reset_fatal_route() {
  local router
  for router in "$WINEPREFIX"/drive_c/users/*/AppData/Roaming/"NZXT CAM"/DataStorage/latest/local/router.json; do
    [ -f "$router" ] || continue
    if grep -q '"/capture"' "$router" 2>/dev/null; then
      printf '{"pathname":"/"}\n' > "$router"
    fi
  done
}

# Started under systemd, stopping this script has to stop CAM with it: the unit is
# gone at logout, and a CAM left behind sits in a tray that no longer exists, still
# driving the cooler, and blocks the next launch with a stale cam_helper.exe.
cleanup() {
  trap - EXIT INT TERM
  [ -n "${poller:-}" ] && kill "$poller" 2>/dev/null
  if [ -n "${cam:-}" ] && kill -0 "$cam" 2>/dev/null; then
    kill "$cam" 2>/dev/null
    for _ in 1 2 3 4 5; do kill -0 "$cam" 2>/dev/null || break; sleep 1; done
  fi
  wineserver -k >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

# The shim cannot read the GPU from inside the prefix, so refresh the readings into a
# file it can. The poller works out where to get them: the kernel's hwmon and DRM
# interfaces for AMD, Intel and nouveau, nvidia-smi for NVIDIA's proprietary driver.
GPU_STATE="$WINEPREFIX/drive_c/windows/temp/nzxt-cam-gpu"
GPU_POLL="$HOME/.local/bin/nzxt-cam-gpu-poll"
if [ -x "$GPU_POLL" ]; then
  mkdir -p "$(dirname "$GPU_STATE")"
  "$GPU_POLL" "$GPU_STATE" 2 >/dev/null 2>&1 &
  poller=$!
fi

CAM_LOG="$WINEPREFIX/drive_c/users/$USER/AppData/Roaming/NZXT CAM/logs/main.log"
cd "$CAMDIR" || exit 1

attempt=0
while :; do
  reset_fatal_route
  apply_device_fixups

  # Only look at log lines this run appends, not a previous session's.
  offset=0
  [ -f "$CAM_LOG" ] && offset=$(wc -c < "$CAM_LOG")

  wine "NZXT CAM.exe" "$@" &
  cam=$!

  crashed=0
  while kill -0 "$cam" 2>/dev/null; do
    if [ -f "$CAM_LOG" ] &&
       tail -c "+$((offset + 1))" "$CAM_LOG" 2>/dev/null | grep -q "Crash threshold reached"; then
      crashed=1
      break
    fi
    sleep 2
  done

  if [ "$crashed" -eq 1 ] && [ "$attempt" -lt 2 ]; then
    attempt=$((attempt + 1))
    echo "nzxt-cam: CAM's renderer crash-looped (the Capture Card page does that under" >&2
    echo "nzxt-cam: Wine). Restarting on the dashboard." >&2
    wineserver -k 2>/dev/null || true
    sleep 3
    continue
  fi

  wait "$cam" 2>/dev/null
  break
done
