+/* Number of bytes actually transferred, for the URB types we submit. */
+static ULONG urb_transfer_length(const URB *urb)
+{
+    switch (urb->UrbHeader.Function)
+    {
+        case URB_FUNCTION_BULK_OR_INTERRUPT_TRANSFER:
+            return urb->UrbBulkOrInterruptTransfer.TransferBufferLength;
+        case URB_FUNCTION_GET_DESCRIPTOR_FROM_DEVICE:
+            return urb->UrbControlDescriptorRequest.TransferBufferLength;
+        case URB_FUNCTION_VENDOR_DEVICE:
+        case URB_FUNCTION_VENDOR_INTERFACE:
+        case URB_FUNCTION_VENDOR_ENDPOINT:
+            return urb->UrbControlVendorClassRequest.TransferBufferLength;
+        default:
+            return 0;
+    }
+}
+
 static void complete_irp(IRP *irp)
 {
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+
     EnterCriticalSection(&wineusb_cs);
     RemoveEntryList(&irp->Tail.Overlay.ListEntry);
     LeaveCriticalSection(&wineusb_cs);
 
+    /* URBs submitted from user mode own a heap URB and must report how much of
+     * the buffered output the I/O manager should copy back. */
+    if (stack->MajorFunction == IRP_MJ_DEVICE_CONTROL
+            && stack->Parameters.DeviceIoControl.IoControlCode == IOCTL_WINEUSB_SUBMIT_URB)
+    {
+        struct wineusb_urb_request *req = irp->AssociatedIrp.SystemBuffer;
+        URB *urb = irp->Tail.Overlay.DriverContext[1];
+
+        req->transfer_length = urb_transfer_length(urb);
+        irp->IoStatus.Information = sizeof(*req) + req->transfer_length;
+        ExFreePool(urb);
+        irp->Tail.Overlay.DriverContext[1] = NULL;
+    }
+
     irp->IoStatus.Status = STATUS_SUCCESS;
     IoCompleteRequest(irp, IO_NO_INCREMENT);
 }
