+/* create a temp file for a copy of PE image sections; on disk where possible, where unlike
+ * memory the pages nobody uses don't take up memory, and the rest can be dropped and read back */
+static int create_image_temp_file( file_pos_t size )
+{
+#if defined(O_TMPFILE) && defined(__linux__)
+    static int use_config_dir = -1;
+    int fd;
+
+    if (use_config_dir && (fd = openat( config_dir_fd, ".", O_TMPFILE | O_RDWR | O_CLOEXEC, 0600 )) != -1)
+    {
+        if (use_config_dir == -1)  /* the sections are mapped executable, so make sure we can */
+        {
+            void *ret = mmap( NULL, get_page_size(), PROT_READ | PROT_EXEC, MAP_PRIVATE, fd, 0 );
+            if (ret != MAP_FAILED) munmap( ret, get_page_size() );
+            use_config_dir = (ret != MAP_FAILED);
+        }
+        if (use_config_dir && grow_file( fd, size )) return fd;
+        close( fd );
+        clear_error();
+    }
+    else use_config_dir = 0;
+#endif
+    return create_temp_file( size );
+}
