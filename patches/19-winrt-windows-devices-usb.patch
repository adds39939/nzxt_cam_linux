+static HRESULT usb_out_stream_create( IUsbDevice *device, UCHAR pipe_id, IOutputStream **out )
+{
+    struct usb_out_stream *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IOutputStream_iface.lpVtbl = &out_stream_vtbl;
+    impl->ref = 1;
+    impl->pipe_id = pipe_id;
+    IUsbDevice_AddRef( (impl->device = device) );
+    *out = &impl->IOutputStream_iface;
+    return S_OK;
+}
