#!/usr/bin/env bash
# Launch NZXT CAM in its patched Wine prefix.
export WINEPREFIX="__PREFIX__"

# Wine's PnP manager rebuilds the device tree (and rewrites DEVPKEY_Device_Parent)
# every time the server starts, so the USB composite-device fixup has to be applied
# after enumeration and before CAM looks for its device. Give plugplay a moment to
# settle first, otherwise the interfaces are not in the registry yet.
FIXUP="$WINEPREFIX/drive_c/windows/system32/usbtree-fixup.exe"
if [ -f "$FIXUP" ]; then
  wine cmd /c exit >/dev/null 2>&1
  sleep 3
  wine "$FIXUP" >/dev/null 2>&1
fi

# CAM is an Electron app and renders at 100% regardless of the desktop's scale, so on
# a scaled display it comes out small. Override with e.g. NZXT_CAM_SCALE=1.5.
scale="${NZXT_CAM_SCALE:-}"
if [ -z "$scale" ] && command -v kscreen-doctor >/dev/null 2>&1; then
  scale=$(kscreen-doctor -o 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' \
          | awk '/Scale:/ {print $2; exit}')
fi
if [ -z "$scale" ] && [ -n "$GDK_SCALE" ]; then scale="$GDK_SCALE"; fi
if [ -z "$scale" ] && command -v xrdb >/dev/null 2>&1; then
  dpi=$(xrdb -query 2>/dev/null | awk -F: '/Xft.dpi/ {gsub(/ /,"",$2); print $2}')
  [ -n "$dpi" ] && scale=$(awk -v d="$dpi" 'BEGIN{printf "%.2f", d/96}')
fi
case "$scale" in ""|0|1|1.0|1.00) scale=1 ;; esac

cd "$WINEPREFIX/drive_c/Program Files/NZXT CAM" || exit 1
if [ "$scale" = "1" ]; then
  exec wine "NZXT CAM.exe" "$@"
else
  exec wine "NZXT CAM.exe" --force-device-scale-factor="$scale" "$@"
fi
