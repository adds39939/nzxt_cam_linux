+/***********************************************************************
+ *           fill_page_vprot
+ *
+ * Fill a run of page protection bytes within one block of the table.
+ */
+static void fill_page_vprot( BYTE *ptr, BYTE vprot, size_t size )
+{
+#ifdef __linux__
+    /* Reserving and releasing memory set the bytes to zero, and a large reservation
+     * covers a lot of table: a terabyte of address space takes 256MB of it. Drop the whole
+     * pages instead of writing them, so that they read as zero without being faulted in. */
+    BYTE *start = ROUND_ADDR( ptr + host_page_mask, host_page_mask );
+    BYTE *end = ROUND_ADDR( ptr + size, host_page_mask );
+
+    if (!vprot && start < end)
+    {
+        memset( ptr, 0, start - ptr );
+        madvise( start, end - start, MADV_DONTNEED );
+        memset( end, 0, ptr + size - end );
+        return;
+    }
+#endif
+    memset( ptr, vprot, size );
+}
+
