+/* Read a DEVPROP_TYPE_STRING_LIST device property into a newly allocated buffer. */
+static WCHAR *devnode_get_string_list_prop( DEVINST node, const DEVPROPKEY *key )
+{
+    struct device dev;
+    struct property prop;
+    DEVPROPTYPE type;
+    WCHAR *buffer;
+    DWORD size = 0;
+
+    if (devnode_get_device( node, &dev )) return NULL;
+    if (init_property( &prop, key, &type, NULL, &size, TRUE )) return NULL;
+    if (get_device_property( HKEY_LOCAL_MACHINE, &dev, &prop ) != ERROR_MORE_DATA || !size) return NULL;
+
+    if (!(buffer = malloc( size + 2 * sizeof(WCHAR) ))) return NULL;
+    memset( buffer, 0, size + 2 * sizeof(WCHAR) );
+    if (init_property( &prop, key, &type, (BYTE *)buffer, &size, TRUE ) ||
+        get_device_property( HKEY_LOCAL_MACHINE, &dev, &prop ))
+    {
+        free( buffer );
+        return NULL;
+    }
+    return buffer;
+}
