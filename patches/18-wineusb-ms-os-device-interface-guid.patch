+/* Microsoft OS 1.0 descriptors. A device advertises support by returning the
+ * signature "MSFT100" from string descriptor 0xee, whose last byte is the vendor
+ * request code used to fetch the feature descriptors. Index 0x0005 is the Extended
+ * Properties descriptor, which is where WinUSB devices publish the device interface
+ * GUID applications open them by. Wine did not read these at all, so such devices
+ * were only reachable through GUID_DEVINTERFACE_USB_DEVICE. */
+#define MS_OS_STRING_DESC_INDEX      0xee
+#define MS_OS_FEATURE_EXT_PROPERTIES 0x0005
+#define MS_OS_PROP_TYPE_SZ           1
+#define MS_OS_PROP_TYPE_MULTI_SZ     7
+
+static bool parse_guid_string(const unsigned char *utf16, ULONG bytes, GUID *guid)
+{
+    char buf[64];
+    ULONG i, len = bytes / 2;
+    unsigned int d[11];
+
+    if (len >= ARRAY_SIZE(buf)) len = ARRAY_SIZE(buf) - 1;
+    for (i = 0; i < len; i++) buf[i] = utf16[i * 2];
+    buf[len] = 0;
+
+    if (sscanf(buf, "{%8x-%4x-%4x-%2x%2x-%2x%2x%2x%2x%2x%2x}", &d[0], &d[1], &d[2],
+               &d[3], &d[4], &d[5], &d[6], &d[7], &d[8], &d[9], &d[10]) != 11)
+        return false;
+
+    guid->Data1 = d[0];
+    guid->Data2 = d[1];
+    guid->Data3 = d[2];
+    for (i = 0; i < 8; i++) guid->Data4[i] = d[3 + i];
+    return true;
+}
+
+static bool get_ms_os_interface_guid(libusb_device_handle *handle, uint8_t interface_num, GUID *guid)
+{
+    unsigned char buf[4096], header[16];
+    ULONG total, count, offset, i;
+    unsigned char vendor_code;
+    int ret;
+
+    ret = libusb_get_string_descriptor(handle, MS_OS_STRING_DESC_INDEX, 0, buf, sizeof(buf));
+    if (ret < 18 || buf[1] != LIBUSB_DT_STRING) return false;
+    /* "MSFT100" in UTF-16LE occupies bytes 2..15, the vendor code follows. */
+    for (i = 0; i < 7; i++)
+        if (buf[2 + i * 2] != "MSFT100"[i]) return false;
+    vendor_code = buf[16];
+
+    ret = libusb_control_transfer(handle,
+            LIBUSB_ENDPOINT_IN | LIBUSB_REQUEST_TYPE_VENDOR | LIBUSB_RECIPIENT_INTERFACE,
+            vendor_code, interface_num, MS_OS_FEATURE_EXT_PROPERTIES, header, sizeof(header), 1000);
+    if (ret < 10) return false;
+
+    total = header[0] | (header[1] << 8) | (header[2] << 16) | ((ULONG)header[3] << 24);
+    if (total < 10 || total > sizeof(buf)) return false;
+
+    ret = libusb_control_transfer(handle,
+            LIBUSB_ENDPOINT_IN | LIBUSB_REQUEST_TYPE_VENDOR | LIBUSB_RECIPIENT_INTERFACE,
+            vendor_code, interface_num, MS_OS_FEATURE_EXT_PROPERTIES, buf, total, 1000);
+    if (ret < (int)total) return false;
+
+    count = buf[8] | (buf[9] << 8);
+    offset = 10;
+    for (i = 0; i < count && offset + 14 <= total; i++)
+    {
+        ULONG size, type, name_len, data_len, name_off, data_off;
+
+        size = buf[offset] | (buf[offset + 1] << 8) | (buf[offset + 2] << 16) | ((ULONG)buf[offset + 3] << 24);
+        type = buf[offset + 4] | (buf[offset + 5] << 8) | (buf[offset + 6] << 16) | ((ULONG)buf[offset + 7] << 24);
+        name_len = buf[offset + 8] | (buf[offset + 9] << 8);
+        name_off = offset + 10;
+        if (!size || offset + size > total || name_off + name_len + 4 > total) break;
+
+        data_len = buf[name_off + name_len] | (buf[name_off + name_len + 1] << 8)
+                 | (buf[name_off + name_len + 2] << 16) | ((ULONG)buf[name_off + name_len + 3] << 24);
+        data_off = name_off + name_len + 4;
+
+        if ((type == MS_OS_PROP_TYPE_SZ || type == MS_OS_PROP_TYPE_MULTI_SZ)
+            && data_off + data_len <= total && parse_guid_string(buf + data_off, data_len, guid))
+        {
+            TRACE("Device interface GUID from MS OS descriptors: %s\n", debugstr_guid(guid));
+            return true;
+        }
+        offset += size;
+    }
+
+    return false;
+}
