+/* check if a section's file data is too misaligned to be mapped from the PE file itself */
+static int is_section_unaligned( const IMAGE_SECTION_HEADER *sec, size_t align_mask, size_t image_size )
+{
+    size_t map_size, file_size;
+    off_t file_start;
+
+    if ((sec->Characteristics & IMAGE_SCN_MEM_SHARED) && (sec->Characteristics & IMAGE_SCN_MEM_WRITE))
+        return 0;
+    get_section_sizes( sec, align_mask, &map_size, &file_start, &file_size );
+    if (!sec->PointerToRawData || !file_size || !(file_start & host_page_mask)) return 0;
+    return sec->VirtualAddress <= image_size && map_size <= image_size - sec->VirtualAddress;
+}
+
+/* allocate and fill a temp file holding the sections that can't be mapped from the PE file
+ * at their virtual address, so that all processes share them instead of reading in a copy */
+static int build_aligned_mapping( struct mapping *mapping, size_t align_mask, int fd,
+                                  IMAGE_SECTION_HEADER *sec, unsigned int nb_sec )
+{
+    static const size_t buffer_size = 0x100000;
+    struct shared_map *aligned;
+    struct file *file;
+    unsigned int i;
+    size_t file_size, map_size, image_size = mapping->image.map_size;
+    off_t read_pos, write_pos;
+    char *buffer = NULL;
+    int aligned_fd;
+
+    if (mapping->image.image_flags & IMAGE_FLAGS_ImageMappedFlat) return 1;
+    for (i = 0; i < nb_sec; i++) if (is_section_unaligned( &sec[i], align_mask, image_size )) break;
+    if (i == nb_sec) return 1;  /* nothing to do */
+
+    if ((mapping->aligned = get_shared_file( &aligned_map_list, mapping->fd ))) return 1;
+
+    /* create a temp file laid out like the image in memory */
+
+    if ((aligned_fd = create_image_temp_file( image_size )) == -1) return 0;
+    if (!(file = create_file_for_fd( aligned_fd, FILE_GENERIC_READ|FILE_GENERIC_WRITE, 0 ))) return 0;
+
+    if (!(buffer = malloc( buffer_size ))) goto error;
+
+    /* copy each unaligned section's data to its virtual address */
+
+    for (i = 0; i < nb_sec; i++)
+    {
+        if (!is_section_unaligned( &sec[i], align_mask, image_size )) continue;
+        get_section_sizes( &sec[i], align_mask, &map_size, &read_pos, &file_size );
+        write_pos = sec[i].VirtualAddress;
+        while (file_size)
+        {
+            ssize_t res = pread( fd, buffer, min( file_size, buffer_size ), read_pos );
+            if (!res) break;  /* partial sector at EOF; the rest reads as zeroes */
+            if (res < 0 || pwrite( aligned_fd, buffer, res, write_pos ) != res) goto error;
+            file_size -= res;
+            read_pos += res;
+            write_pos += res;
+        }
+    }
+
+    if (!(aligned = alloc_object( &shared_map_ops ))) goto error;
+    aligned->fd = (struct fd *)grab_object( mapping->fd );
+    aligned->file = file;
+    list_add_head( &aligned_map_list, &aligned->entry );
+    mapping->aligned = aligned;
+    free( buffer );
+    return 1;
+
+ error:
+    release_object( file );
+    free( buffer );
+    return 0;
+}
