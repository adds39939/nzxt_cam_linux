+++ include/wine/wineusb.h
+/*
+ * Private interface between wineusb.sys and winusb.dll.
+ *
+ * wineusb.sys only exposes IOCTL_INTERNAL_USB_SUBMIT_URB, which user mode cannot
+ * reach. This adds a buffered device-control code carrying the same URB requests
+ * so that winusb.dll can drive a device without a kernel-mode counterpart.
+ *
+ * This library is free software; you can redistribute it and/or modify it under
+ * the terms of the GNU Lesser General Public License as published by the Free
+ * Software Foundation; either version 2.1 of the License, or (at your option)
+ * any later version.
+ */
+
+#ifndef __WINE_WINE_WINEUSB_H
+#define __WINE_WINE_WINEUSB_H
+
+#include <winioctl.h>
+
+#define IOCTL_WINEUSB_SUBMIT_URB \
+    CTL_CODE(FILE_DEVICE_UNKNOWN, 0x800, METHOD_BUFFERED, FILE_READ_ACCESS | FILE_WRITE_ACCESS)
+
+enum wineusb_urb_type
+{
+    WINEUSB_URB_CONTROL,      /* vendor/class request on device, interface or endpoint */
+    WINEUSB_URB_BULK,         /* bulk or interrupt transfer */
+    WINEUSB_URB_DESCRIPTOR,   /* GET_DESCRIPTOR from device */
+    WINEUSB_URB_RESET_PIPE,   /* reset pipe and clear stall */
+    WINEUSB_URB_ABORT_PIPE,
+};
+
+/* Buffered request: this header is followed by transfer_length bytes of payload.
+ * The same buffer is used for input and output, so on completion the header's
+ * transfer_length is updated with the number of bytes actually transferred and
+ * any inbound payload follows it. */
+struct wineusb_urb_request
+{
+    ULONG type;             /* enum wineusb_urb_type */
+    ULONG transfer_length;  /* in: requested; out: actually transferred */
+    ULONG flags;            /* WINEUSB_TRANSFER_* */
+    UCHAR endpoint;         /* bulk/interrupt/reset/abort */
+    UCHAR request_type;     /* control: bmRequestType */
+    UCHAR request;          /* control: bRequest */
+    UCHAR descriptor_type;  /* descriptor: wValue high byte */
+    UCHAR descriptor_index; /* descriptor: wValue low byte */
+    UCHAR pipe_type;        /* USBD_PIPE_TYPE for bulk/interrupt transfers */
+    UCHAR pad[2];
+    USHORT value;           /* control: wValue */
+    USHORT index;           /* control/descriptor: wIndex */
+};
+
+#define WINEUSB_TRANSFER_IN 0x00000001  /* device-to-host */
+
+#endif /* __WINE_WINE_WINEUSB_H */
