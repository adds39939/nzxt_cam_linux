+DEFINE_USB_OBJECT_BASE( in_stream, IInputStream, struct usb_in_stream,
+                        L"Windows.Storage.Streams.IInputStream" )
+
+static HRESULT in_stream_read( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct usb_in_stream *impl = impl_from_IInputStream( (IInputStream *)invoker );
+    struct usb_device *device = impl_from_IUsbDevice( impl->device );
+    IBuffer *buffer = (IBuffer *)param;
+    IBufferByteAccess *access;
+    ULONG read = 0;
+    UINT32 capacity;
+    BYTE *data;
+
+    IBuffer_get_Capacity( buffer, &capacity );
+    if (FAILED(IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access ))) return E_NOINTERFACE;
+    IBufferByteAccess_Buffer( access, &data );
+    IBufferByteAccess_Release( access );
+
+    if (!WinUsb_ReadPipe( device->winusb, impl->pipe_id, data, capacity, &read, NULL ))
+    {
+        WARN( "WinUsb_ReadPipe failed on pipe %#x, error %lu.\n", impl->pipe_id, GetLastError() );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+
+    IBuffer_put_Length( buffer, read );
+    result->vt = VT_UNKNOWN;
+    IBuffer_AddRef( buffer );
+    result->punkVal = (IUnknown *)buffer;
+    return S_OK;
+}
+
+static HRESULT WINAPI in_stream_ReadAsync( IInputStream *iface, IBuffer *buffer, UINT32 count,
+                                           InputStreamOptions options,
+                                           IAsyncOperationWithProgress_IBuffer_UINT32 **operation )
+{
+    TRACE( "iface %p, buffer %p, count %u, options %#x, operation %p.\n", iface, buffer, count, options, operation );
+    if (!operation) return E_POINTER;
+    return async_operation_buffer_uint32_create( (IUnknown *)iface, (IUnknown *)buffer, in_stream_read, operation );
+}
